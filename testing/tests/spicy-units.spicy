# @TEST-DOC: Unit tests of individual parsing units, fed corpus-lifted and crafted bytes through spicy-driver; the harness in testing/Files prints what each unit decoded.
#
# @TEST-EXEC: spicyc -j -d -o tds.hlto ${DIST}/analyzer/tds.spicy ${DIST}/testing/Files/harness.spicy

# PRELOGIN request from a pytds client.
# @TEST-EXEC: printf '\000\000\032\000\006\001\000\040\000\001\002\000\041\000\014\003\000\055\000\004\004\000\061\000\001\377\001\000\000\000\000\000\002\115\123\123\121\114\123\145\162\166\145\162\000\000\000\000\000\000' | spicy-driver -p TDSTest::Prelogin tds.hlto >>output 2>&1
# LOGIN7 from the same client (SQL authentication).
# @TEST-EXEC: printf '\370\000\000\000\004\000\000\164\000\020\000\000\000\000\000\001\317\212\000\000\000\000\000\000\360\002\000\010\324\376\377\377\011\004\000\000\136\000\016\000\172\000\002\000\176\000\014\000\226\000\017\000\264\000\011\000\000\000\000\000\306\000\022\000\352\000\000\000\352\000\007\000\002\102\254\021\000\002\000\000\000\000\370\000\000\000\370\000\000\000\000\000\000\000\167\000\157\000\162\000\153\000\163\000\164\000\141\000\164\000\151\000\157\000\156\000\055\000\060\000\061\000\163\000\141\000\000\245\363\245\363\245\023\245\340\245\343\245\222\245\267\245\206\245\246\245\206\245\306\245\172\000\145\000\145\000\153\000\055\000\164\000\144\000\163\000\055\000\143\000\157\000\162\000\160\000\165\000\163\000\061\000\062\000\067\000\056\000\060\000\056\000\060\000\056\000\061\000\120\000\171\000\164\000\150\000\157\000\156\000\040\000\124\000\104\000\123\000\040\000\114\000\151\000\142\000\162\000\141\000\162\000\171\000\172\000\145\000\145\000\153\000\164\000\144\000\163\000' | spicy-driver -p TDSTest::Login7 tds.hlto >>output 2>&1
# Server response to a failed login: ERROR 18456 then DONE.
# @TEST-EXEC: printf '\252\126\000\030\110\000\000\001\016\033\000\114\000\157\000\147\000\151\000\156\000\040\000\146\000\141\000\151\000\154\000\145\000\144\000\040\000\146\000\157\000\162\000\040\000\165\000\163\000\145\000\162\000\040\000\047\000\163\000\141\000\047\000\056\000\011\163\000\161\000\154\000\145\000\144\000\147\000\145\000\060\000\061\000\000\001\000\000\000\375\002\000\000\000\000\000\000\000\000\000\000\000' | spicy-driver -p TDSTest::Tokens tds.hlto >>output 2>&1
# TDS 7.1 RPC (no ALL_HEADERS): sp_prepexec by number with five parameters.
# @TEST-EXEC: printf '\026\000\000\000\022\000\000\000\002\000\000\000\000\000\000\000\000\000\001\000\000\000\377\377\015\000\000\000\000\001\046\004\004\000\000\000\000\000\000\347\100\037\011\004\320\000\064\064\000\100\000\120\000\060\000\040\000\156\000\166\000\141\000\162\000\143\000\150\000\141\000\162\000\050\000\064\000\060\000\060\000\060\000\051\000\054\000\100\000\120\000\061\000\040\000\151\000\156\000\164\000\000\000\347\100\037\011\004\320\000\064\220\000\163\000\145\000\154\000\145\000\143\000\164\000\040\000\052\000\040\000\146\000\162\000\157\000\155\000\040\000\164\000\145\000\163\000\164\000\137\000\164\000\141\000\142\000\154\000\145\000\137\000\061\000\040\000\167\000\150\000\145\000\162\000\145\000\040\000\156\000\141\000\155\000\145\000\040\000\075\000\040\000\100\000\120\000\060\000\040\000\141\000\156\000\144\000\040\000\151\000\144\000\040\000\075\000\040\000\100\000\120\000\061\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\040\000\000\000\347\100\037\011\004\320\000\064\006\000\172\000\172\000\172\000\000\000\046\004\004\002\000\000\000' | spicy-driver -p TDSTest::RPC tds.hlto >>output 2>&1
# SMP framing from a MARS client: two SYNs and a DATA packet carrying an RPC.
# @TEST-EXEC: printf '\123\001\000\000\020\000\000\000\000\000\000\000\004\000\000\000\123\001\001\000\020\000\000\000\000\000\000\000\004\000\000\000\123\010\001\000\001\001\000\000\001\000\000\000\004\000\000\000\003\001\000\361\000\000\001\000\026\000\000\000\022\000\000\000\002\000\000\000\000\000\000\000\000\000\001\000\000\000\377\377\012\000\002\000\000\000\347\214\000\011\004\320\000\064\214\000\123\000\105\000\114\000\105\000\103\000\124\000\040\000\151\000\144\000\054\000\040\000\164\000\141\000\147\000\054\000\040\000\166\000\141\000\154\000\165\000\145\000\040\000\106\000\122\000\117\000\115\000\040\000\144\000\142\000\157\000\056\000\162\000\145\000\141\000\144\000\151\000\156\000\147\000\163\000\040\000\127\000\110\000\105\000\122\000\105\000\040\000\166\000\141\000\154\000\165\000\145\000\040\000\076\000\040\000\100\000\155\000\151\000\156\000\040\000\117\000\122\000\104\000\105\000\122\000\040\000\102\000\131\000\040\000\151\000\144\000\000\000\347\024\000\011\004\320\000\064\024\000\100\000\155\000\151\000\156\000\040\000\146\000\154\000\157\000\141\000\164\000\004\100\000\155\000\151\000\156\000\000\155\010\010\000\000\000\000\000\000\064\100' | spicy-driver -p TDSTest::Frames tds.hlto >>output 2>&1
# One TYPE_INFO + TYPE_VARBYTE per line, rendered by type.
# @TEST-EXEC: printf '\046\004\004\300\000\000\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # intn(4) = 192
# @TEST-EXEC: printf '\347\012\000\011\004\320\000\064\012\000\102\000\157\000\147\000\165\000\163\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # nvarchar(5) = Bogus
# @TEST-EXEC: printf '\347\377\377\011\004\320\000\064\004\000\000\000\000\000\000\000\004\000\000\000\150\000\151\000\000\000\000\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # nvarchar(max) PLP = hi
# @TEST-EXEC: printf '\152\005\010\004\005\001\136\210\274\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # decimaln(8,4) = 1235.5678
# @TEST-EXEC: printf '\150\001\001\001' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # bitn = true
# @TEST-EXEC: printf '\044\020\020\000\021\042\063\104\125\146\167\210\231\252\273\314\335\356\377' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # uniqueidentifier
# @TEST-EXEC: printf '\050\003\030\112\013' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # date = 2026-09-06
# @TEST-EXEC: printf '\157\010\010\371\233\000\000\000\000\000\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # datetime 2009-04-28
# @TEST-EXEC: printf '\156\010\010\000\000\000\000\010\342\001\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # money 12.3400
# @TEST-EXEC: printf '\245\003\000\003\000\012\013\014' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # varbinary(3)
# @TEST-EXEC: printf '\155\010\010\000\000\000\000\000\000\370\077' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # float 1.5
# @TEST-EXEC: printf '\046\004\000' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # NULL intn
# @TEST-EXEC: printf '\060\377' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # tinyint 255
# @TEST-EXEC: printf '\070\377\377\377\377' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # int -1
# @TEST-EXEC: printf '\051\003\004\323\050\327\002' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # time(3) 13:14:15.123
# @TEST-EXEC: printf '\053\002\010\171\256\005\030\112\013\324\376' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # datetimeoffset(2) 01:02:03.45 2026-09-06 -05:00
# @TEST-EXEC: printf '\361\000\377\377\377\377\377\377\377\377' | spicy-driver -p TDSTest::Value tds.hlto >>output 2>&1   # xml PLP null
# @TEST-EXEC: TEST_DIFF_CANONIFIER= btest-diff output
